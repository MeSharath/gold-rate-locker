# Gold Investment Timing Optimizer - Environment Configuration

# Database path (relative to project root)
DATABASE_PATH=data/gold_rates.db

# Email configuration (optional - app works without these)
# For Gmail, use an App Password: https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_PASSWORD=your_app_password_here
EMAIL_TO=recipient@email.com

# Application URL (for email links)
APP_URL=https://your-app.railway.app

# Algorithm parameters (optional - these have sensible defaults)
# OBSERVATION_DAYS=10
# OPPORTUNISTIC_END=22
# DEADLINE_START=23
# EXCEPTIONAL_DROP_THRESHOLD=0.03
# NEAR_MONTH_LOW_TOLERANCE=0.005
# MOVING_AVERAGE_WINDOW=20
# GST_RATE=0.03
